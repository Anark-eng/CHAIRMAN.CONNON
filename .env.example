# Copy this file to .env.local and fill in your own Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# Never commit your real .env.local file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public web address people visit your site at, e.g.
# https://your-project.vercel.app or your custom domain. This is used to
# tell Supabase where to send readers back to after they click a link in a
# confirmation or password-reset email.
#
# Leave blank on Vercel: the site falls back to NEXT_PUBLIC_VERCEL_URL,
# which Vercel fills in automatically. Locally, it falls back to
# http://localhost:3000. Fill it in if you have a real domain — links from
# emails will send readers to the domain you enter here instead of the
# Vercel preview URL.
NEXT_PUBLIC_SITE_URL=

# A private server-side secret used to sign the guest reader cookie so
# nobody can hand-edit it to forge a new "guest" identity per request.
# Any string of at least 16 random characters works. Generate one with
# `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
#
# NOT prefixed with NEXT_PUBLIC_ — it must never reach the browser.
# Required for guest read recording; without it, guests aren't tracked.
# Changing this value invalidates every existing guest cookie, so every
# returning guest looks brand new to trending. Rotate deliberately.
NOVELTREND_GUEST_SECRET=
